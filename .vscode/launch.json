{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "agora2bids: convert exam (Agora)",
            "type": "debugpy",
            "request": "launch",
            "module": "agora2bids.cli",
            "args": ["14", "--output", "D:\\temp\\bids"],
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "agora2bids: dry run (classify only)",
            "type": "debugpy",
            "request": "launch",
            "module": "agora2bids.cli",
            "args": ["${input:examId}", "--output", "${input:outputDir}", "--dry-run"],
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "agora2bids: convert exam, keep temp files",
            "type": "debugpy",
            "request": "launch",
            "module": "agora2bids.cli",
            "args": ["${input:examId}", "--output", "${input:outputDir}", "--keep-temp"],
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ],
    "inputs": [
        {
            "id": "examId",
            "type": "promptString",
            "description": "Agora exam (study) id"
        },
        {
            "id": "outputDir",
            "type": "promptString",
            "description": "BIDS output directory (created or extended)",
            "default": "D:/temp/bids_out"
        }
    ]
}
